# hypersocial backend — copy to backend/.env and fill in ONE tweet source key.
# Real environment variables override this file. Never commit .env.

# ── Tweet source ────────────────────────────────────────────────
# twitterapi | xapi. Empty = auto: TWITTERAPI_KEY if set, else X_BEARER_TOKEN.
TWEET_SOURCE=
# twitterapi.io key (https://twitterapi.io, sent as X-API-Key). Pay per tweet returned.
TWITTERAPI_KEY=
# Official X API v2 app Bearer token (https://developer.x.com). Recent search = last 7 days only.
X_BEARER_TOKEN=

# ── Server ──────────────────────────────────────────────────────
# PORT=8787
# 1 = serve the synthetic samples in fixtures/ and make no upstream calls (no key needed).
# FIXTURE=
# Comma list of coins accepted by /v1/signals (must exist on Hyperliquid).
# COINS=HYPE
# ENV_FILE=            # load a different env file instead of backend/.env

# ── What counts as a call ───────────────────────────────────────
# MIN_FOLLOWERS=1000
# MAX_CASHTAGS=4              # tweets naming more distinct cashtags are list spam
# MIN_ACCOUNT_AGE_DAYS=30
# MAX_FOLLOWING_RATIO=5       # following/followers above this = follow-farm
# MAX_PER_AUTHOR=3            # per window
# SPAM_WORDS=giveaway,airdrop,presale,whitelist,dm me,join my,telegram,t.me/,signals group,vip,CA:,contract address,referral,promo code,use code

# ── Cost / rate-limit caps (both sources) ───────────────────────
# MAX_CALLS_PER_HOUR=120      # hard cap on upstream search calls; over it, the last cached data is served
# RATE_LIMIT_RETRIES=2        # retries on 429/5xx
# RATE_LIMIT_MAX_WAIT_MS=15000
# TTL_15M_MS=60000            # response cache per window
# TTL_7D_MS=600000
# TTL_30D_MS=600000

# ── twitterapi.io fetch plan ────────────────────────────────────
# TW_PAGES_15M=2              # 20 tweets/page, "Latest"
# TW_PAGES_PER_DAY=1          # 7d/30d: one "Top" query per UTC day
# TW_MIN_FAVES_DAY=5
# TW_CLOSED_DAY_TTL_MS=43200000
# TWITTERAPI_BASE=https://api.twitterapi.io

# ── X API v2 fetch plan ─────────────────────────────────────────
# X_PAGES_15M=1
# X_PAGES_7D=3                # pages for 7d/30d (shared search)
# X_MAX_RESULTS=100           # 10..100 per page
# X_QUERY="{cashtag} -is:retweet -is:reply"   # {cashtag}=$HYPE, {coin}=HYPE; use {coin} if your tier lacks the cashtag operator
# X_API_BASE=https://api.x.com

# ── Output ──────────────────────────────────────────────────────
# BUCKET_WIDTH=5              # byPrice bucket width in USD
